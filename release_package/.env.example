# Required: session token from chatgpt.com.
CHATGPT_SESSION_TOKEN=your-session-token-here

# Required: high-entropy application key for all /v1 routes.
PROXY_API_KEY=replace-with-a-32-character-or-longer-random-secret

# Required: stable JWT signing secret for dashboard sessions.
JWT_SECRET=replace-with-a-32-character-or-longer-random-secret

# Required: dashboard administrator password.
ADMIN_PASSWORD=replace-with-a-strong-dashboard-password

PORT=3000
HOST=0.0.0.0
