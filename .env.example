# .env.example - Environment variables for the ChatGPT-to-API proxy

# Required: session token from chatgpt.com.
CHATGPT_SESSION_TOKEN=your-session-token-here

# Required: high-entropy credential used only by trusted Vercel server functions
# and direct OpenAI-compatible clients. Use at least 32 random characters.
PROXY_API_KEY=replace-with-a-32-character-or-longer-random-secret

# Required: high-entropy, stable JWT signing secret for dashboard sessions.
# Changing it signs out every dashboard user.
JWT_SECRET=replace-with-a-32-character-or-longer-random-secret

# Required: dashboard administrator password. This remains a Render-only secret.
# Use at least 12 characters and do not commit a real value.
ADMIN_PASSWORD=replace-with-a-strong-dashboard-password

# Optional: server port and host.
PORT=3000
HOST=0.0.0.0

# Optional: directly provide a ChatGPT access token to bypass session refresh challenges.
CHATGPT_ACCESS_TOKEN=

# Optional: refresh token for automatic access-token renewal.
CHATGPT_REFRESH_TOKEN=
